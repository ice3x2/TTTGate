{
  "productName": "TTTGate Launcher",
  "version": "../../package.json",
  "identifier": "com.snoworca.tttgate.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TTTGate",
        "width": 520,
        "height": 680,
        "minWidth": 440,
        "minHeight": 560,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
